   void DxvkXrProvider::initDeviceExtensions(const DxvkInstance* instance) {
     std::lock_guard<dxvk::mutex> lock(m_mutex);
 
-    if (!m_wineOxr || m_initializedDevExt)
+    if (m_initializedDevExt)
       return;
-    
-    m_devExtensions = this->queryDeviceExtensions();
-    m_initializedDevExt = true;
 
-    this->shutdown();
+    if (m_wineOxr) {
+      m_devExtensions = this->queryDeviceExtensions();
+      m_initializedDevExt = true;
+      this->shutdown();
+      return;
+    }
+
+    // Windows: the lists were fetched together with the instance extensions; drop whatever a GPU does not
+    // offer, a missing extension would otherwise fail vkCreateDevice and take the whole game down with it
+    for (uint32_t i = 0; instance->enumAdapters(i) != nullptr; i++)
+      m_devExtensionsPerAdapter.push_back(this->filterSupportedDeviceExtensions(instance, i, m_devExtensions));
+
+    m_initializedDevExt = true;
   }
 
 
