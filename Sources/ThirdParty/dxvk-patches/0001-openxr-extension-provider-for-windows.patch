+
   DxvkExtensionList DxvkXrProvider::parseExtensionList(const std::string& str) const {
     DxvkExtensionList result;
-    
+
     std::stringstream strstream(str);
     std::string       section;
-    
-    while (std::getline(strstream, section, ' '))
-      result.push_back(vk::makeExtension(section.c_str()));
-    
+
+    while (std::getline(strstream, section, ' ')) {
+      // the lists come back NUL-terminated and may carry stray whitespace
+      while (!section.empty() && (section.back() == '\0' || section.back() == ' ' || section.back() == '\n' || section.back() == '\r'))
+        section.pop_back();
+
+      if (!section.empty())
+        result.push_back(vk::makeExtension(section.c_str()));
+    }
+
+    return result;
+  }
+
+
+  DxvkExtensionList DxvkXrProvider::filterSupportedInstanceExtensions(const DxvkExtensionList& requested) const {
+    // vulkan-1.dll is already loaded by DxvkInstance at this point
+    HMODULE vulkan = ::GetModuleHandleA("vulkan-1.dll");
+
+    auto vkEnumerateInstanceExtensionProperties = vulkan
+      ? reinterpret_cast<PFN_vkEnumerateInstanceExtensionProperties>(::GetProcAddress(vulkan, "vkEnumerateInstanceExtensionProperties"))
+      : nullptr;
+
+    if (!vkEnumerateInstanceExtensionProperties)
+      return requested;
+
+    uint32_t count = 0;
+    if (vkEnumerateInstanceExtensionProperties(nullptr, &count, nullptr) != VK_SUCCESS)
+      return requested;
+
+    std::vector<VkExtensionProperties> supported(count);
+    if (vkEnumerateInstanceExtensionProperties(nullptr, &count, supported.data()) != VK_SUCCESS)
+      return requested;
+
+    DxvkExtensionList result;
+
+    for (const auto& ext : requested) {
+      bool found = false;
+
+      for (const auto& s : supported) {
+        if ((found = !std::strncmp(ext.extensionName, s.extensionName, sizeof(s.extensionName))))
+          break;
+      }
+
+      if (found)
+        result.push_back(ext);
+      else
+        Logger::warn(str::format("OpenXR: Instance extension ", ext.extensionName, " not supported, skipping"));
+    }
+
+    return result;
+  }
+
+
+  DxvkExtensionList DxvkXrProvider::filterSupportedDeviceExtensions(
+    const DxvkInstance*       instance,
+          uint32_t            adapterId,
+    const DxvkExtensionList&  requested) const {
+    Rc<DxvkAdapter> adapter = instance->enumAdapters(adapterId);
+    auto vki = instance->vki();
+
+    uint32_t count = 0;
+    if (vki->vkEnumerateDeviceExtensionProperties(adapter->handle(), nullptr, &count, nullptr) != VK_SUCCESS)
+      return requested;
+
+    std::vector<VkExtensionProperties> supported(count);
+    if (vki->vkEnumerateDeviceExtensionProperties(adapter->handle(), nullptr, &count, supported.data()) != VK_SUCCESS)
+      return requested;
+
+    DxvkExtensionList result;
+
+    for (const auto& ext : requested) {
+      bool found = false;
+
+      for (const auto& s : supported) {
+        if ((found = !std::strncmp(ext.extensionName, s.extensionName, sizeof(s.extensionName))))
+          break;
+      }
+
+      if (found)
+        result.push_back(ext);
+      else
+        Logger::warn(str::format("OpenXR: Device extension ", ext.extensionName, " not supported by adapter ", adapterId, ", skipping"));
+    }
+
     return result;
   }
