@@ -69,16 +173,126 @@ namespace dxvk {
   }
 
 
+  bool DxvkXrProvider::queryNativeRuntime() {
+    auto xrGetInstanceProcAddr = reinterpret_cast<oxr::PFN_xrGetInstanceProcAddr>(
+      ::GetProcAddress(m_oxrLoader, "xrGetInstanceProcAddr"));
+
+    if (!xrGetInstanceProcAddr) {
+      Logger::warn("OpenXR: xrGetInstanceProcAddr not found in openxr_loader.dll");
+      return false;
+    }
+
+    oxr::PFN_xrCreateInstance  xrCreateInstance  = nullptr;
+    oxr::PFN_xrDestroyInstance xrDestroyInstance = nullptr;
+    oxr::PFN_xrGetSystem       xrGetSystem       = nullptr;
+
+    xrGetInstanceProcAddr(0, "xrCreateInstance",  reinterpret_cast<oxr::PFN_xrVoidFunction*>(&xrCreateInstance));
+    xrGetInstanceProcAddr(0, "xrDestroyInstance", reinterpret_cast<oxr::PFN_xrVoidFunction*>(&xrDestroyInstance));
+    xrGetInstanceProcAddr(0, "xrGetSystem",       reinterpret_cast<oxr::PFN_xrVoidFunction*>(&xrGetSystem));
+
+    if (!xrCreateInstance || !xrDestroyInstance || !xrGetSystem) {
+      Logger::warn("OpenXR: Loader entry points not found");
+      return false;
+    }
+
+    // A throwaway instance: XR_KHR_vulkan_enable is the extension that knows about Vulkan requirements
+    const char* extensions[] = { "XR_KHR_vulkan_enable" };
+
+    oxr::XrInstanceCreateInfo createInfo = { };
+    createInfo.type = oxr::XR_TYPE_INSTANCE_CREATE_INFO;
+    std::strncpy(createInfo.applicationInfo.applicationName, env::getExeName().c_str(), sizeof(createInfo.applicationInfo.applicationName) - 1);
+    createInfo.applicationInfo.applicationVersion = 1;
+    std::strncpy(createInfo.applicationInfo.engineName, "DXVK", sizeof(createInfo.applicationInfo.engineName) - 1);
+    createInfo.applicationInfo.engineVersion = 1;
+    createInfo.applicationInfo.apiVersion = oxr::XR_API_VERSION_1_0;
+    createInfo.enabledExtensionCount = 1;
+    createInfo.enabledExtensionNames = extensions;
+
+    oxr::XrInstance instance = 0;
+    oxr::XrResult res = xrCreateInstance(&createInfo, &instance);
+
+    if (res != oxr::XR_SUCCESS || !instance) {
+      Logger::warn(str::format("OpenXR: xrCreateInstance failed: ", res, " (no runtime, or no XR_KHR_vulkan_enable)"));
+      return false;
+    }
+
+    bool success = false;
+
+    oxr::XrSystemGetInfo systemInfo = { };
+    systemInfo.type = oxr::XR_TYPE_SYSTEM_GET_INFO;
+    systemInfo.formFactor = oxr::XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+
+    oxr::XrSystemId systemId = 0;
+    res = xrGetSystem(instance, &systemInfo, &systemId);
+
+    if (res != oxr::XR_SUCCESS) {
+      Logger::warn(str::format("OpenXR: xrGetSystem failed: ", res, " (is the headset connected?)"));
+    } else {
+      oxr::PFN_xrGetVulkanExtensions xrGetVulkanInstanceExtensionsKHR = nullptr;
+      oxr::PFN_xrGetVulkanExtensions xrGetVulkanDeviceExtensionsKHR   = nullptr;
+
+      xrGetInstanceProcAddr(instance, "xrGetVulkanInstanceExtensionsKHR", reinterpret_cast<oxr::PFN_xrVoidFunction*>(&xrGetVulkanInstanceExtensionsKHR));
+      xrGetInstanceProcAddr(instance, "xrGetVulkanDeviceExtensionsKHR",   reinterpret_cast<oxr::PFN_xrVoidFunction*>(&xrGetVulkanDeviceExtensionsKHR));
+
+      if (!xrGetVulkanInstanceExtensionsKHR || !xrGetVulkanDeviceExtensionsKHR) {
+        Logger::warn("OpenXR: xrGetVulkan*ExtensionsKHR not found");
+      } else {
+        auto query = [&] (oxr::PFN_xrGetVulkanExtensions fn, const char* what, DxvkExtensionList& result) {
+          uint32_t len = 0;
+          oxr::XrResult r = fn(instance, systemId, 0, &len, nullptr);
+
+          if (r != oxr::XR_SUCCESS) {
+            Logger::warn(str::format("OpenXR: Unable to get required Vulkan ", what, " extensions size: ", r));
+            return false;
+          }
+
+          std::vector<char> extensionList(len + 1, '\0');
+          r = fn(instance, systemId, len, &len, extensionList.data());
+
+          if (r != oxr::XR_SUCCESS) {
+            Logger::warn(str::format("OpenXR: Unable to get required Vulkan ", what, " extensions: ", r));
+            return false;
+          }
+
+          result = parseExtensionList(std::string(extensionList.data()));
+          return true;
+        };
+
+        success = query(xrGetVulkanInstanceExtensionsKHR, "instance", m_insExtensions)
+               && query(xrGetVulkanDeviceExtensionsKHR,   "device",   m_devExtensions);
+      }
+    }
+
+    xrDestroyInstance(instance);
+
+    if (!success) {
+      m_insExtensions.clear();
+      m_devExtensions.clear();
+    }
+
+    return success;
+  }
